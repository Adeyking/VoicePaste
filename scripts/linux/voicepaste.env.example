# VoicePaste Linux Configuration
# Place this file at ~/.config/voicepaste/env

# Speech-to-text server URL (defaults to http://localhost:8770)
STT_URL="http://YOUR-SERVER-IP:8770"

# Optional bearer token if your STT endpoint requires authentication
STT_BEARER_TOKEN=""

# Dictation language code (default: en)
STT_LANGUAGE="en"

# Maximum recording time in seconds before auto-stopping
MAX_SECONDS="120"
